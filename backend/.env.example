# ==============================================================================
# AgentPay Backend Environment Configuration
# Copy this file to .env and configure values appropriate for your environment.
# DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# Application Environment: 'development' | 'test' | 'production'
APP_ENV=development
NODE_ENV=development
PORT=5050

# PostgreSQL Database Connection URL
# Production: Required (e.g. postgresql://user:password@db-host:5432/agentpay)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentpay

# Redis Connection URL
# Production: Required (e.g. redis://:password@redis-host:6379)
REDIS_URL=redis://localhost:6379

# Authentication & Cryptography
# Production: Required (must be a cryptographically random string >= 32 characters)
JWT_SECRET=your_cryptographically_secure_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_DAYS=30
QUOTE_SIGNING_SECRET=your_quote_signing_secret_here

# Payment Rails Configuration
# Mode: 'test' (Razorpay Sandbox) | 'live' (Production Governed Rails)
PAYMENT_MODE=test
LIVE_AUTONOMOUS_COMMERCE_MODE=disabled

# Razorpay Test / Sandbox Credentials (Used when PAYMENT_MODE=test)
RAZORPAY_TEST_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_TEST_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_TEST_WEBHOOK_SECRET=whsec_test_placeholder_secret

# Razorpay Live Production Credentials (REQUIRED ONLY when PAYMENT_MODE=live)
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# AI Service & LLM Provider
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-3.7-flash

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Safety Limits & Platform Thresholds (in INR)
PLATFORM_MAX_TRANSACTION_LIMIT=25000
PLATFORM_MAX_DAILY_LIMIT=50000
